#!/bin/bash
#SBATCH --job-name=PIPE_SEMI_SUPERVISED
#SBATCH --account=st-ipor-1-gpu
#SBATCH --partition=gpu
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=16
#SBATCH --mem=128G
#SBATCH --time=72:00:00
#SBATCH --gpus=4
#SBATCH --output=/scratch/st-ipor-1/cperez/MedSAM/hpc_logs/%x-%j.out
#SBATCH --error=/scratch/st-ipor-1/cperez/MedSAM/hpc_logs/%x-%j.err
#SBATCH --mail-user=cperez67@student.ubc.ca
#SBATCH --mail-type=FAIL,END

set -euo pipefail

############################
# 1. Environment Setup
############################
REPO_DIR="/scratch/st-ipor-1/cperez/MedSAM"
export REPO_DIR
export PYTHONPATH="${REPO_DIR}:${PYTHONPATH:-}"

source "${REPO_DIR}/slurm/setup.sh"
setup_env

cd "${REPO_DIR}"
mkdir -p "${REPO_DIR}/hpc_logs"

############################
# 2. Arguments & Defaults
############################
# Default Confidence Threshold (can be overridden via CLI: --conf=0.85)
CONF_THRESH=0.75
DUP_FACTOR=2

# Parse command line arguments
for arg in "$@"; do
  case "$arg" in
    --conf=*)
      CONF_THRESH="${arg#*=}"
      ;;
    --dup=*)
      DUP_FACTOR="${arg#*=}"
      ;;
  esac
done

# Calculate integer percentage for filenames (e.g., 0.88 -> 88)
# Using python for consistent rounding with the generation script
CONF_PCT=$(python -c "print(int(round(${CONF_THRESH} * 100)))")

############################
# 3. Path Configuration
############################
# --- Input Data Paths ---
PRED_DEV="${REPO_DIR}/src/image_data/parquet/predictions/predictions_dev.parquet"
PRED_EYEPACS="${REPO_DIR}/src/image_data/parquet/predictions/predictions_eyepacs.parquet"
YOLO_SPLIT="${REPO_DIR}/src/image_data/parquet/images_dev_yolo_split.parquet"

# --- Intermediate Output (Parquet) ---
# This directory stores the filtered parquet file
PROCESSED_DIR="${REPO_DIR}/src/image_data/parquet/processed_semi_supervised"
# The expected filename generated by run_process_predictions.py
FINAL_PARQUET="${PROCESSED_DIR}/final_semi_supervised_dataset_${CONF_PCT}.parquet"

# --- Training Output ---
# Unique directories for this specific confidence run to avoid collisions
OUT_YOLO_DS="${REPO_DIR}/DS/YOLO_SEMI_FINAL_CONF${CONF_PCT}"
RUNS_ROOT="${REPO_DIR}/runs/semi_supervised_conf${CONF_PCT}"

# --- Weights ---
INIT_WEIGHTS="${REPO_DIR}/weights/yolo12x.pt"

############################
# 4. Step 1: Process & Filter Predictions
############################
echo "============================================================"
echo "[STEP 1] Processing Predictions"
echo "  Confidence: $CONF_THRESH ($CONF_PCT%)"
echo "  Inputs: Dev + Eyepacs + Real GT Split"
echo "  Output: $FINAL_PARQUET"
echo "============================================================"

mkdir -p "$PROCESSED_DIR"

# Note: We use srun --exclusive if running multiple steps to ensure resources are clear,
# but here sequential execution is standard.
srun --cpu-bind=cores -u \
  python -m src.tools.parquet_processing.run_process_predictions \
    --pred-dev "${PRED_DEV}" \
    --pred-eyepacs "${PRED_EYEPACS}" \
    --yolo-split "${YOLO_SPLIT}" \
    --out-dir "${PROCESSED_DIR}" \
    --conf "${CONF_THRESH}" \
    --duplication-factor "${DUP_FACTOR}"

if [[ ! -f "$FINAL_PARQUET" ]]; then
    echo "[ERROR] Expected output parquet not found at: $FINAL_PARQUET"
    echo "Check if the python script logic for filename generation matches 'final_semi_supervised_dataset_${CONF_PCT}.parquet'"
    exit 1
fi

############################
# 5. Step 2: Train YOLO Semi-Supervised
############################
echo "============================================================"
echo "[STEP 2] Training YOLO"
echo "  Input Parquet: $FINAL_PARQUET"
echo "  Dataset Dir:   $OUT_YOLO_DS"
echo "  Runs Dir:      $RUNS_ROOT"
echo "============================================================"

# Determine GPU configuration
if [[ -n "${CUDA_VISIBLE_DEVICES:-}" ]]; then
  YOLO_DEVICES="${CUDA_VISIBLE_DEVICES}"
else
  YOLO_DEVICES="0,1,2,3"
fi

# Optional: Clean previous DS build for this conf if you want a forced rebuild
# rm -rf "$OUT_YOLO_DS"

srun --gpu-bind=closest --cpu-bind=cores -u \
  python -m src.scripts.train_yolo_semi \
    --images-parquet "${FINAL_PARQUET}" \
    --out-yolo-ds "${OUT_YOLO_DS}" \
    --runs-root "${RUNS_ROOT}" \
    --init-weights "${INIT_WEIGHTS}" \
    --device "${YOLO_DEVICES}" \
    --epochs 200 \
    --batch 16 \
    --imgsz 640 \
    --workers 16

echo "[INFO] Pipeline Finished Successfully."